    {
      "id": "g2",
      "name": "failing-test",
      "utility": 10,
      "partial_utility": 4,
      "required": true
    },
    {
      "id": "g3",
      "name": "patch",
      "utility": 10,
      "partial_utility": 4,
      "required": true
    },
    {
      "id": "g4",
      "name": "suite",
      "utility": 10,
      "partial_utility": 4,
      "required": true
    }
  ],
  "steps": [
    {
      "gate": "g1",
      "cost": 2000,
      "body": "repro case for the empty input",
      "observation": "failure is deterministic on empty input"
    },
    {
      "gate": "g2",
      "cost": 2000,
      "body": "failing regression pinned",
      "observation": "suite fails in handler",
